# ===== Prenotami 帳號 =====
PRENOTAMI_EMAIL=your_email@example.com
PRENOTAMI_PASSWORD=your_password

# ===== 簽證申請個人資料 =====
# 填表時會自動帶入這些資料
PASSPORT_NUMBER=000000000
NATIONALITY=Taiwan

# ===== Telegram 通知（推薦）=====
# 1. 在 Telegram 找 @BotFather 建立 bot 拿 token
# 2. 找 @userinfobot 取得你的 chat_id
TG_BOT_TOKEN=
TG_CHAT_ID=

# ===== Email 通知（備用）=====
# Gmail 必須使用「應用程式密碼」，不是登入密碼
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=

# ===== 監測設定 =====
# 檢查間隔（分鐘），會在這個範圍隨機抽
CHECK_INTERVAL_MIN=30
CHECK_INTERVAL_MAX=90
